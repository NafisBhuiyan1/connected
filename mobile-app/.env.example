# Optional: send assistant questions to the Claude proxy in /server.
# Without these, the app uses its built-in assistant (no AI service needed).
# EXPO_PUBLIC_ values are bundled into the app, so never put an Anthropic API key here.
EXPO_PUBLIC_ASSISTANT_URL=http://YOUR-PC-IP:8787/assistant
EXPO_PUBLIC_ASSISTANT_TOKEN=pick-any-long-random-string

# Supabase backend (Project Settings -> API). The publishable key is safe in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Copy to .env.local and fill in. Never commit real keys.

# Optional: enables Claude for goal understanding, intro drafts and icebreakers.
# Without it, Connected falls back to its deterministic rules engine (the UI says which one ran).
ANTHROPIC_API_KEY=

# Optional: override the Claude model (default: claude-opus-5-5).
CONNECTED_AI_MODEL=

# Required in production: secret used to sign session cookies (any long random string).
SESSION_SECRET=

# Optional: where the JSON datastore lives (default: ./.data). On Vercel this falls back to /tmp.
CONNECTED_DATA_DIR=

# Set to "off" to hide the demo control room and persona switching.
DEMO_MODE=on
